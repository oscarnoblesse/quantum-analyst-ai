"""Signature électronique des lettres de voiture (e-CMR), conservées 10 ans."""

import os

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec

DUREE_CONSERVATION_ANS = 10


def charger_cle():
    with open("cles/signature-cmr.pem", "rb") as fichier:
        return serialization.load_pem_private_key(fichier.read(), password=os.environ["PHRASE_CLE_CMR"].encode())


def signer(document: bytes) -> bytes:
    return charger_cle().sign(document, ec.ECDSA(hashes.SHA256()))
