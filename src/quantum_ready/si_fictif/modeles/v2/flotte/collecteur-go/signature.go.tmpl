package main

import (
	"crypto"
	"crypto/rand"
	"crypto/rsa"
	"crypto/sha256"
)

// Clé du collecteur, régénérée à chaque démarrage.
var cleCollecteur, _ = rsa.GenerateKey(rand.Reader, 2048)

func signerLot(lot []byte) ([]byte, error) {
	empreinte := sha256.Sum256(lot)
	return rsa.SignPKCS1v15(rand.Reader, cleCollecteur, crypto.SHA256, empreinte[:])
}
